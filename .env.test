# Loaded by .build/phpunit-bootstrap.php through Shopware's TestBootstrapper.
# Keep this file SAFE TO COMMIT — secrets go in .env.test.local (gitignored).

APP_ENV=test
APP_DEBUG=1
APP_SECRET=ChangeMe_TestOnly

DATABASE_URL=mysql://root:root@127.0.0.1:3306/shopware_test
MAILER_DSN=null://null

SHOPWARE_ES_ENABLED=0
SHOPWARE_ES_INDEXING_ENABLED=0
SHOPWARE_ADMIN_ES_ENABLED=0
SHOPWARE_ES_THROW_EXCEPTION=0

# Mock-file sessions + filesystem cache + sync messenger — no Redis / Rabbit.
# Same trick the CI image uses; see .github/ci/symfony-ci-overrides.yaml.
REDIS_CACHE_HOST=127.0.0.1
REDIS_SESSION_HOST=127.0.0.1
LOCK_DSN=flock
MESSENGER_TRANSPORT_DSN=sync://
