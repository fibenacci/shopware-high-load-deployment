# Named source profiles for `make fetch-dump PROFILE=<name>`.
# Copy to .fetch-dump.local.env (gitignored) and fill in.
#
# One block per remote you ever pull from. Names become the PROFILE argument:
#   make fetch-dump PROFILE=prod
#   make fetch-dump PROFILE=staging
#   make fetch-dump PROFILE=legacy
#
# Variable naming: <PROFILE_UPPER>_<KEY>. Hyphens in profile names become
# underscores (so PROFILE=eu-1 → EU_1_SSH_DEST).
#
# Security:
#   • This file MUST NOT be committed (it's in .gitignore).
#   • Prefer a read-only DB user — `shopware_readonly` is plenty for a dump.
#   • The script opens an SSH ControlMaster tunnel that's torn down on exit;
#     no DB port is exposed beyond the lifetime of the dump.

# ----- profile: prod -------------------------------------------------------
PROD_SSH_DEST=deploy@shop.example.com
PROD_SSH_PORT=22
# What to forward to inside the SSH host (usually the local DB or a managed
# DB endpoint reachable from inside the VPC).
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_NAME=shopware
PROD_DB_USER=shopware_readonly
PROD_DB_PASSWORD=changeme

# ----- profile: staging ----------------------------------------------------
STAGING_SSH_DEST=deploy@staging.shop.example.com
STAGING_SSH_PORT=22
STAGING_DB_HOST=127.0.0.1
STAGING_DB_PORT=3306
STAGING_DB_NAME=shopware
STAGING_DB_USER=shopware_readonly
STAGING_DB_PASSWORD=changeme

# ----- profile: legacy (example for migration scenarios) -------------------
# LEGACY_SSH_DEST=root@old-shop.example.com
# LEGACY_SSH_PORT=2222
# LEGACY_DB_HOST=db.internal
# LEGACY_DB_PORT=3306
# LEGACY_DB_NAME=oldshop
# LEGACY_DB_USER=migration
# LEGACY_DB_PASSWORD=changeme
