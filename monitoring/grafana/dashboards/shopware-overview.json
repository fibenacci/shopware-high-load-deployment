{
    "title": "Shopware — Overview",
    "uid": "shopware-overview",
    "schemaVersion": 39,
    "timezone": "browser",
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "30s",
    "tags": ["shopware"],
    "templating": {
        "list": [
            { "name": "namespace", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": "label_values(kube_namespace_labels, namespace)", "current": { "value": "shopware-staging" } }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Request rate (RPS)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [{ "expr": "sum(rate(nginx_http_requests_total[1m]))" }],
            "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "5xx rate",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [{ "expr": "sum(rate(nginx_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(nginx_http_requests_total[5m]))" }],
            "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.02 }] } } },
            "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "p95 latency",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))" }],
            "fieldConfig": { "defaults": { "unit": "s" } },
            "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "PHP-FPM saturation",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [{ "expr": "max(phpfpm_active_processes / phpfpm_total_processes)" }],
            "fieldConfig": { "defaults": { "unit": "percentunit" } },
            "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Request rate by status",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [{ "expr": "sum by (status) (rate(nginx_http_requests_total[1m]))", "legendFormat": "{{status}}" }],
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Latency percentiles",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
                { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
                { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
            ],
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
        },
        {
            "id": 7,
            "type": "logs",
            "title": "Recent nginx errors",
            "datasource": { "type": "loki", "uid": "loki" },
            "targets": [{ "expr": "{container=~\".*app.*\", status=~\"5..\"}" }],
            "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }
        }
    ]
}
