# =============================================================================
# Global configuration — single source of truth for this shop.
#
# Sourced by:
#   • Makefile               (top-level `include deployment.config` line)
#   • docker/Dockerfile      (build args default to these values)
#   • compose.yaml           (via .env / shell expansion)
#   • .github/workflows/*    (read into $GITHUB_ENV at job start)
#   • deploy/bare-metal/*    (sourced by deploy.sh)
#   • deploy/kubernetes/*    (read by scripts that rewrite kustomize images)
#
# Format: plain shell `KEY=VALUE`. No spaces around `=`, no quotes needed for
# bare words. Don't put secrets here — those belong in .env.local / K8s
# Secrets / your secret manager.
# =============================================================================

# --- Project identity -------------------------------------------------------
PROJECT_NAME=shopware-shop
PROJECT_DOMAIN=shop.docker
PROJECT_VENDOR=example
# Bumped automatically by release-please on tagged releases.
# x-release-please-start-version
PROJECT_VERSION=0.1.0
# x-release-please-end

# --- Software versions (pinned) --------------------------------------------
SHOPWARE_VERSION=6.6.5.1
PHP_VERSION=8.3
NODE_VERSION=22
COMPOSER_VERSION=2.7

# Dev image (Dockware) tag is derived from SHOPWARE_VERSION below — override
# only if you need a non-standard variant (e.g. dockware/play, custom tag).
DOCKWARE_IMAGE=dockware/dev
DOCKWARE_TAG=${SHOPWARE_VERSION}

# --- Deployment mode -------------------------------------------------------
# Selects which `make deploy` path runs. One of:
#   docker             — local docker compose only (no remote target)
#   kubernetes         — kubectl apply -k against the cluster in $KUBECONFIG
#   bare-metal         — rsync + SSH via Deployer (deploy.php) + deployment-helper
#   managed-container  — SSH + docker compose pull/up against a single Docker
#                        host (TimmeHosting Container Hosting, Hetzner Cloud,
#                        DigitalOcean Droplet, generic VPS).
DEPLOYMENT_MODE=kubernetes

# --- Container registry (only used when DEPLOYMENT_MODE=kubernetes) --------
REGISTRY=ghcr.io
REGISTRY_NAMESPACE=${PROJECT_VENDOR}/${PROJECT_NAME}
IMAGE_APP=${REGISTRY}/${REGISTRY_NAMESPACE}/shopware
IMAGE_WORKER=${REGISTRY}/${REGISTRY_NAMESPACE}/shopware-worker
# Cron uses IMAGE_APP with args:[cron] — no separate image needed.
IMAGE_BACKUP=${REGISTRY}/${REGISTRY_NAMESPACE}/shopware-backup
# Varnish — point at Shopware's official image. Override only if you
# build a custom VCL via docker/varnish/Dockerfile.
IMAGE_VARNISH=ghcr.io/shopware/varnish-shopware
IMAGE_TAG_STAGING=staging
IMAGE_TAG_PRODUCTION=stable

# --- Shopware installation (consumed by deployment-helper on fresh installs) ---
# https://developer.shopware.com/docs/guides/hosting/installation-updates/deployments/deployment-helper.html
INSTALL_LOCALE=de-DE
INSTALL_CURRENCY=EUR
INSTALL_ADMIN_USERNAME=admin
# INSTALL_ADMIN_PASSWORD lives in Secret, never here

# --- Shopware base image variant (Dockerfile build args) -------------------
# https://developer.shopware.com/docs/guides/hosting/installation-updates/docker.html
SHOPWARE_BASE=ghcr.io/shopware/docker-base
SHOPWARE_CLI_IMAGE=ghcr.io/shopware/shopware-cli
PHP_RUNTIME=frankenphp

# --- APM toggle ------------------------------------------------------------
# 1 bakes Tideways into the prod image; 0 leaves it out (default).
TIDEWAYS_ENABLE=0
TIDEWAYS_VERSION=2024.1.2

# --- Bare-metal targets (only used when DEPLOYMENT_MODE=bare-metal) -------
# Per-env config lives in deploy/bare-metal/<env>.env; this only sets the
# default environment when `make deploy` is called without ENV=...
DEFAULT_ENV=staging
