{
    "_template": "TEMPLATE — not a copy-target. Rendered from deployment.config by `make composer-json`. Single source of truth for version drift; CI fails on drift. Placeholders: __SHOPWARE_VERSION__ (exact pin, e.g. 6.6.5.1), __SHOPWARE_MINOR__ (used ONLY for Symfony Flex recipe selection which has no patch granularity), __PHP_VERSION__ (e.g. 8.3).",

    "name": "example/shopware-shop",
    "description": "Shopware 6 shop based on the shopware-shop-deployment template.",
    "type": "project",
    "license": "proprietary",
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": { "*": "dist" },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Shopware\\Production\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shopware\\Production\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "custom/plugins/*",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": { "symlink": true }
        }
    ],
    "extra": {
        "symfony": {
            "endpoint": [
                "https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json",
                "flex://defaults"
            ],
            "require": "~__SHOPWARE_MINOR__"
        }
    },
    "require": {
        "php": "~__PHP_VERSION__.0",
        "composer-runtime-api": "^2.0",
        "_comment_shopware": "Exact pin on purpose — patch bumps are a coordinated change touching deployment.config + Docker image + CHANGELOG. This project IS a shopware/production-style skeleton (we provide Shopware\\Production\\HttpKernel + Kernel in src/), so we don't depend on shopware/production itself — only on the constituent packages.",
        "shopware/administration": "__SHOPWARE_VERSION__",
        "shopware/core": "__SHOPWARE_VERSION__",
        "shopware/elasticsearch": "__SHOPWARE_VERSION__",
        "shopware/storefront": "__SHOPWARE_VERSION__",

        "_comment_deployment": "Canonical Shopware post-upload pipeline — drives the .shopware-project.yml. https://developer.shopware.com/docs/guides/hosting/installation-updates/deployments/deployment-helper.html",
        "shopware/deployment-helper": "^1.0",

        "_comment_docker": "stdout log routing for Docker / Kubernetes",
        "shopware/docker": "^1.0",

        "_comment_filesystem": "S3-compatible object storage for media/theme/thumbnail/sitemap. Shopware recommends async-aws-s3 over aws-s3-v3 — lower memory footprint, same API. See docs/object-storage.md. https://developer.shopware.com/docs/guides/hosting/infrastructure/filesystem.html",
        "league/flysystem-async-aws-s3": "^3.0",

        "_comment_apm": "OTel auto-instrumentation + Pyroscope continuous profiling. See apm/README.md.",
        "open-telemetry/opentelemetry-auto-symfony": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "open-telemetry/exporter-otlp": "^1.0",
        "grafana/pyroscope-php": "^1.0"
    },
    "require-dev": {
        "_comment_deployer": "Capistrano-style atomic deploys, integrates with shopware/deployment-helper via the sw:deployment:helper task in deploy.php. https://developer.shopware.com/docs/guides/hosting/installation-updates/deployments/deployment-with-deployer.html",
        "deployer/deployer": "^7.5",

        "_comment_tests": "Static analysis + style enforcement — matches .build/ configs.",
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-symfony": "^1.4",
        "phpstan/phpstan-phpunit": "^1.3",
        "friendsofphp/php-cs-fixer": "^3.50",
        "squizlabs/php_codesniffer": "^3.10",
        "phpmd/phpmd": "^2.15"
    },
    "scripts": {
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"]
    }
}
