# =========================================================================
# Shopware Shop Deployment — template env. Copy to .env.local for local dev.
#
# SECRETS:
#   • Local dev:        .env.local (gitignored). Values below are example
#                       defaults safe ONLY for a laptop loopback stack.
#   • CI:               GitHub Actions secrets — see docs/secrets.md.
#   • Kubernetes prod:  k8s/base/secret.yaml is a placeholder; back it with
#                       External Secrets / Sealed Secrets / SOPS / Vault.
#   • Managed/bare:     deploy/<mode>/env/<env>.env is gitignored; pass via
#                       GitHub Action `secrets.MANAGED_CONTAINER_ENV` /
#                       `secrets.DEPLOY_SSH_KEY` in CI.
#
# Never reuse the values below outside a local laptop.
# =========================================================================

# --- Project identity ----------------------------------------------------
COMPOSE_PROJECT_NAME=shopware-shop
PROJECT_DOMAIN=shop.docker

# --- App ------------------------------------------------------------------
APP_ENV=dev
APP_URL=http://shop.docker
APP_SECRET=ChangeMe_LocalOnly
INSTANCE_ID=local

# --- Database -------------------------------------------------------------
DATABASE_URL=mysql://shopware:shopware@mariadb:3306/shopware
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=shopware
MYSQL_USER=shopware
MYSQL_PASSWORD=shopware

# --- Search ---------------------------------------------------------------
OPENSEARCH_URL=http://opensearch:9200
SHOPWARE_ES_ENABLED=1
SHOPWARE_ES_INDEXING_ENABLED=1
SHOPWARE_ES_INDEX_PREFIX=sw
ADMIN_OPENSEARCH_URL=http://opensearch:9200
SHOPWARE_ADMIN_ES_ENABLED=1
SHOPWARE_ADMIN_ES_REFRESH_INDICES=1
SHOPWARE_ADMIN_ES_INDEX_PREFIX=sw-admin

# --- Cache / sessions / locks --------------------------------------------
REDIS_CACHE_HOST=redis
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=redis
REDIS_CACHE_DATABASE=1
REDIS_SESSION_HOST=redis
REDIS_SESSION_PORT=6379
REDIS_SESSION_PASSWORD=redis
REDIS_SESSION_DATABASE=0
REDIS_DSN=redis://:redis@redis:6379
LOCK_DSN=flock

# --- Messenger ------------------------------------------------------------
RABBITMQ_DSN_DEFAULT=amqp://shopware:shopware@rabbitmq:5672/%2f
MESSENGER_TRANSPORT_DSN=doctrine://default

# --- Mail -----------------------------------------------------------------
MAILER_DSN=smtp://mailpit:1025

# --- Storefront proxy -----------------------------------------------------
STOREFRONT_PROXY_URL=http://shop.docker

# --- Search (opt-in for local dev) ---------------------------------------
OPENSEARCH_ADMIN_PASSWORD=Admin123!Strong

# --- Messenger ------------------------------------------------------------
RABBITMQ_USER=shopware
RABBITMQ_PASSWORD=shopware

# --- Shopware install defaults (deployment-helper, fresh install) --------
INSTALL_LOCALE=de-DE
INSTALL_CURRENCY=EUR
INSTALL_ADMIN_USERNAME=admin
INSTALL_ADMIN_PASSWORD=shopware
INSTALL_ADMIN_EMAIL=admin@localhost.local

# --- Shopware Store (only needed for paid extensions) --------------------
SHOPWARE_STORE_ACCOUNT_EMAIL=
SHOPWARE_STORE_ACCOUNT_PASSWORD=
SHOPWARE_STORE_LICENSE_DOMAIN=

# --- Monitoring stack (compose.monitoring.yaml) --------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANON_ENABLED=true

# --- Observability (opt-in for local dev) --------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
TIDEWAYS_APIKEY=
PYROSCOPE_SERVER_ADDRESS=
