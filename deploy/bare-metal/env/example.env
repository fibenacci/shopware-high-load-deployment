# Per-environment bare-metal target. Copy to <env>.env (e.g. staging.env,
# production.env) and fill in. Never commit the populated files — they're
# in .gitignore.

# SSH target
REMOTE_HOST=shop.example.com
REMOTE_PORT=22
REMOTE_USER=deploy
REMOTE_SSH_KEY=~/.ssh/id_ed25519

# Remote paths
REMOTE_PATH=/var/www/shopware
RELEASES_TO_KEEP=5

# PHP / FPM control on the remote
REMOTE_PHP_BIN=/usr/bin/php8.3
REMOTE_FPM_RELOAD_CMD="sudo systemctl reload php8.3-fpm"
# Set to 1 if your hosting provider doesn't grant sudo for fpm reload —
# opcache will then rely on opcache.validate_timestamps OR a `touch` of the
# bootloader file. The deploy script handles both.
NO_FPM_RELOAD=0

# Public URL used by the smoke test
PUBLIC_URL=https://staging.shop.example.com

# Shared paths that survive between releases (relative to REMOTE_PATH/shared/).
# Override only if your shop adds extra plugin-local upload paths.
SHARED_DIRS="config/jwt public/media public/thumbnail public/sitemap public/bundles public/theme var/log files"
SHARED_FILES=".env.local auth.json"

# Optional: skip post-deploy steps. Useful for the first ever deploy where
# the database isn't yet populated.
SKIP_MIGRATIONS=0
SKIP_THEME_COMPILE=0
