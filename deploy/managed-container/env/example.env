# Per-environment managed-container target. Copy to <env>.env (e.g.
# production.env, staging.env) and fill in. Never commit the populated
# files — they're in .gitignore.

# --- SSH target --------------------------------------------------------------
REMOTE_HOST=shop.example.com
REMOTE_PORT=22
REMOTE_USER=deploy
REMOTE_SSH_KEY=~/.ssh/id_ed25519
REMOTE_PATH=/srv/shopware

# --- Image to deploy ---------------------------------------------------------
# CI sets IMAGE_TAG=$GITHUB_SHA when invoked from .github/workflows/deploy.yml;
# manual deploys can leave this unset → falls back to the `stable` tag.
IMAGE_TAG=stable
WORKER_REPLICAS=2

# --- Networking --------------------------------------------------------------
# How the hoster reaches the web container. Most managed hosters edge-proxy
# to localhost; some need 0.0.0.0:80. Check their docs.
APP_BIND=127.0.0.1
APP_PORT=8000
PUBLIC_URL=https://shop.example.com

# --- Stateful services -------------------------------------------------------
# STATEFUL=stateful enables the in-stack MariaDB/Redis/OpenSearch/RabbitMQ.
# Leave unset (or empty) if the hoster gives you managed services and you
# point DATABASE_URL / REDIS_DSN / etc. at their internal hostnames.
STATEFUL=
# Required only when STATEFUL=stateful:
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# --- Shopware runtime config (override what's in deployment.config) ---------
APP_URL=https://shop.example.com
DATABASE_URL=mysql://shopware:CHANGEME@db:3306/shopware
REDIS_DSN=redis://:CHANGEME@redis:6379

# --- GHCR pull credentials (only if your image is private) ------------------
# Set GHCR_USER + GHCR_TOKEN here; deploy.sh logs the remote into GHCR before
# pulling. Skip if your image is public.
GHCR_USER=
GHCR_TOKEN=
