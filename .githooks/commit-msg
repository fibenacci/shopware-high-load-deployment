#!/usr/bin/env bash
# commit-msg hook — keeps subjects shaped well enough for release-please.
#
# release-please reads conventional-commit prefixes to bucket the CHANGELOG:
#
#   feat:     → Features      (minor bump)
#   fix:      → Bug Fixes     (patch bump)
#   perf:     → Performance   (patch bump)
#   security: → Security      (patch bump)
#   deps:     → Dependencies  (patch bump)
#   refactor / docs / test / build / ci / chore  → hidden from changelog
#
# Append `!` after type (or include `BREAKING CHANGE:` in the body) for a
# major bump: `feat!: drop PHP 8.2 support`.
#
# Hard rejects:
#   • subject > 100 chars
#   • subject ending with `.`
#
# Soft warnings (hard with COMMIT_MSG_STRICT=1):
#   • missing conventional-commits prefix
#
# Skip with `git commit --no-verify` for revert / merge commits.

set -euo pipefail

msg_file="$1"
subject="$(head -n1 "${msg_file}")"

red()    { printf "\033[1;31m%s\033[0m\n" "$*" >&2; }
yellow() { printf "\033[1;33m%s\033[0m\n" "$*" >&2; }

# Always allow auto-generated subjects.
case "${subject}" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# Hard checks.
if [ "${#subject}" -gt 100 ]; then
    red "✗ commit subject too long (${#subject} > 100 chars):"
    red "  ${subject}"
    exit 1
fi
case "${subject}" in
    *.) red "✗ commit subject ends with a period: ${subject}"; exit 1 ;;
esac

# Conventional-commits shape — soft-warn unless strict mode.
cc_re='^(feat|fix|perf|security|deps|refactor|docs|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'
if ! printf '%s' "${subject}" | grep -qE "${cc_re}"; then
    if [ "${COMMIT_MSG_STRICT:-0}" = "1" ]; then
        red "✗ subject doesn't match conventional-commits (COMMIT_MSG_STRICT=1):"
        red "  ${subject}"
        red "  expected: <type>(<scope>)?: <subject>"
        exit 1
    else
        yellow "⚠ subject doesn't match conventional-commits — release-please will skip it."
        yellow "  ${subject}"
    fi
fi

exit 0
